{
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"compilerOptions": {
		"target": "ES2024",
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"module": "ESNext",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		// The ambient sets core's own check reads: Node for the prepare scripts and the
		// tests, the Workers runtime for the catalogue's serving half (explorer/catalogue/
		// serve). Named here, never as a reference in a source file: a consumer's program
		// has its own generated runtime types, and a second copy breaks its `Cloudflare.Env`.
		"types": ["node", "@types/d3-force", "@types/three", "@cloudflare/workers-types"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
